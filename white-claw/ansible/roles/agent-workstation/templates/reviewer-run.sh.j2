#!/bin/bash
# white-claw reviewer agent: reviews each new head commit of every open agent/* PR once,
# then posts the ai-review commit status. GitHub auto-merge does the rest once ci + ai-review pass.
# Optional follow-ups the reviewer flags are filed as issues labelled from-review (not agent-ready).
set -euo pipefail
MAX_TURNS={{ agent_max_turns_review }}
MAX_SUGGESTIONS={{ agent_max_suggestions_per_review }}
{% raw %}
REPO="${AGENT_REPO:?set by agent-run.sh}"
WD="${AGENT_WORKDIR:?set by agent-run.sh}"
STATE="${AGENT_STATE:?set by agent-run.sh}"

exec 9>"$STATE/lock"
flock -n 9 || { echo "[reviewer] previous run still active"; exit 0; }

log() { echo "[reviewer] $*"; }

post_status() {  # sha state description
  gh api -X POST "repos/$REPO/statuses/$1" \
    -f state="$2" -f context=ai-review -f description="$3" >/dev/null
}

comment() {  # pr body
  gh api -X POST "repos/$REPO/issues/$1/comments" -f body="$2" >/dev/null
}

file_suggestions() {  # pr json-array
  local pr=$1 items=$2 open_titles title body
  [ "$(jq length <<<"$items")" -eq 0 ] && return 0
  gh label create from-review --repo "$REPO" --color c5def5 \
    --description "Follow-up flagged by the reviewer agent" >/dev/null 2>&1 || true
  open_titles=$(gh issue list --repo "$REPO" --state open --limit 200 --json title --jq '.[].title')
  while IFS= read -r item; do
    title=$(jq -r .title <<<"$item")
    if grep -Fxq -- "$title" <<<"$open_titles"; then continue; fi
    body="$(jq -r .body <<<"$item")

_Flagged by the reviewer agent on #$pr. The planner agent will triage it._"
    gh issue create --repo "$REPO" --title "$title" --body "$body" --label from-review >/dev/null \
      && log "filed follow-up: $title"
  done < <(jq -c '.[]' <<<"$items")
}

cd "$WD"
git fetch -q --prune origin '+refs/heads/main:refs/remotes/origin/main' '+refs/pull/*/head:refs/remotes/origin/pr/*'

prs=$(gh pr list --repo "$REPO" --state open --json number,headRefName,headRefOid \
  --jq '.[] | select(.headRefName | startswith("agent/")) | "\(.number) \(.headRefOid)"')
[ -z "$prs" ] && { log "nothing to review"; exit 0; }

while read -r num sha; do
  [ -f "$STATE/reviewed-$sha" ] && continue
  log "reviewing PR #$num @ ${sha:0:7}"
  post_status "$sha" pending "Reviewer agent is reviewing"

  # Hard gate, no model involved: agents may not touch servo limits or CI.
  files=$(gh pr diff "$num" --repo "$REPO" --name-only)
  if grep -Eq '^(config/limits|\.github/)' <<<"$files"; then
    comment "$num" "## ai-review: FAIL

This PR modifies a protected path (\`config/limits*\` or \`.github/\`). Agents may not change servo limits or CI.

**Required change:** revert every change under those paths."
    post_status "$sha" failure "Touches protected paths"
    touch "$STATE/reviewed-$sha"
    continue
  fi

  # The linked issue, so scope is judged against what was asked for.
  issue_num=$(gh pr view "$num" --repo "$REPO" --json closingIssuesReferences \
    --jq '.closingIssuesReferences[0].number // empty')
  if [ -n "$issue_num" ]; then
    issue_text=$(gh issue view "$issue_num" --repo "$REPO" --json title,body --jq '"\(.title)\n\n\(.body)"' 2>/dev/null \
      || echo "(could not fetch issue #$issue_num)")
  else
    issue_text="(no linked issue)"
  fi

  git checkout -q --detach "$sha"

  env -u GH_TOKEN claude -p "Review pull request #$num. The PR head is checked out as a detached HEAD.

Linked issue:
---
$issue_text
---

Run 'git diff origin/main...HEAD' and 'git log origin/main..HEAD', read any files you need, and run the tests.
Apply the review rules in your CLAUDE.md.
Your final line must be exactly 'VERDICT: PASS' or 'VERDICT: FAIL'." \
    --output-format json --max-turns "$MAX_TURNS" < /dev/null \
    > "$STATE/last-review.json" 2> "$STATE/last-review.err" || true

  result=$(jq -r '.result // empty' "$STATE/last-review.json" 2>/dev/null || true)
  verdict=$(grep -Eo 'VERDICT: (PASS|FAIL)' <<<"$result" | tail -1 || true)
  parsed=$("$HOME/bin/wc-parse.py" review "$MAX_SUGGESTIONS" <<<"$result")
  body=$(jq -r .comment <<<"$parsed")
  body="${body:0:60000}"
  suggestions=$(jq -c .suggestions <<<"$parsed")

  case "$verdict" in
    "VERDICT: PASS")
      post_status "$sha" success "Approved by reviewer agent"
      comment "$num" "## ai-review: PASS

$body"
      touch "$STATE/reviewed-$sha"
      file_suggestions "$num" "$suggestions"
      ;;
    "VERDICT: FAIL")
      post_status "$sha" failure "Changes requested by reviewer agent"
      comment "$num" "## ai-review: FAIL

$body"
      touch "$STATE/reviewed-$sha"
      file_suggestions "$num" "$suggestions"
      ;;
    *)
      # No verdict (API error, spend cap, turn limit). Leave it unreviewed so the next tick retries.
      post_status "$sha" error "Reviewer produced no verdict; will retry"
      log "no verdict for #$num; see $STATE/last-review.err"
      ;;
  esac
done <<<"$prs"

git checkout -q --detach origin/main
{% endraw %}
