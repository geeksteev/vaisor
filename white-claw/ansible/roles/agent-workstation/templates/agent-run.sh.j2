#!/bin/bash
# white-claw {{ agent_role }} dispatcher: runs one {{ agent_role }} cycle for each repo in turn.
# A failure in one repo is logged and does not stop the others.
set -uo pipefail
REPOS=({% for r in agent_repos %}"{{ r }}" {% endfor %})
{% raw %}
exec 8>"$HOME/state/dispatch.lock"
flock -n 8 || { echo "[dispatch] previous run still active"; exit 0; }

for repo in "${REPOS[@]}"; do
  slug="${repo/\//__}"
  export AGENT_REPO="$repo"
  export AGENT_WORKDIR="$HOME/work/$slug"
  export AGENT_STATE="$HOME/state/$slug"
  mkdir -p "$AGENT_STATE"
  if [ ! -d "$AGENT_WORKDIR/.git" ]; then
    git clone -q "https://github.com/$repo.git" "$AGENT_WORKDIR" || { echo "[dispatch] cannot clone $repo"; continue; }
  fi
  echo "[dispatch] == $repo"
  "$HOME/bin/agent-repo.sh" || echo "[dispatch] $repo cycle exited $?"
done
{% endraw %}
