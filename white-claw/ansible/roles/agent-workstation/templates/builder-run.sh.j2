#!/bin/bash
# white-claw builder agent: one cycle per timer tick.
#   1. If an agent PR is open and CI or ai-review failed -> fix it (max {{ agent_max_fix_attempts }} tries).
#   2. If no agent PR is open -> take the oldest issue labelled agent-ready and open a PR for it.
# The agent only commits. This script does all pushing and PR handling, so the model never
# holds a path to main and never needs the GitHub token in its tool environment.
set -euo pipefail
MAX_TURNS={{ agent_max_turns_build }}
MAX_FIX={{ agent_max_fix_attempts }}
{% raw %}
REPO="${AGENT_REPO:?set by agent-run.sh}"
WD="${AGENT_WORKDIR:?set by agent-run.sh}"
STATE="${AGENT_STATE:?set by agent-run.sh}"

exec 9>"$STATE/lock"
flock -n 9 || { echo "[builder] previous run still active"; exit 0; }

log() { echo "[builder] $*"; }

run_claude() {
  # GH_TOKEN is stripped so nothing the model runs can reach GitHub.
  env -u GH_TOKEN claude -p "$1" --output-format json --max-turns "$MAX_TURNS" \
    > "$STATE/last-run.json" 2> "$STATE/last-run.err" || true
  jq -r '.result // empty' "$STATE/last-run.json" 2>/dev/null | tail -20 || true
}

check_state() {
  local sha=$1 ci review
  ci=$(gh api "repos/$REPO/commits/$sha/check-runs" \
        --jq '[.check_runs[] | select(.name=="ci")][0].conclusion // "pending"')
  review=$(gh api "repos/$REPO/commits/$sha/status" \
        --jq '[.statuses[] | select(.context=="ai-review")][0].state // "none"')
  echo "$ci $review"
}

cd "$WD"
git fetch -q --prune origin
git checkout -q main
git reset -q --hard origin/main
git clean -fdq

# ---- 1. Fix pass: only ever one agent PR in flight -------------------------
pr_json=$(gh pr list --repo "$REPO" --state open --json number,headRefName,headRefOid \
  --jq '[.[] | select(.headRefName | startswith("agent/"))] | sort_by(.number) | .[0] // empty')

if [ -n "$pr_json" ]; then
  num=$(jq -r .number <<<"$pr_json")
  branch=$(jq -r .headRefName <<<"$pr_json")
  sha=$(jq -r .headRefOid <<<"$pr_json")
  read -r ci review < <(check_state "$sha")
  merge_state=$(gh pr view "$num" --repo "$REPO" --json mergeStateStatus --jq .mergeStateStatus)
  log "PR #$num ($branch) ci=$ci ai-review=$review merge=$merge_state"

  # Ruleset requires up-to-date branches; auto-merge won't rebase on its own.
  if [ "$merge_state" = "BEHIND" ]; then
    gh pr update-branch "$num" --repo "$REPO" --rebase && log "rebased #$num onto main"
    exit 0
  fi

  if [ "$ci" = "failure" ] || [ "$review" = "failure" ]; then
    attempts_file="$STATE/pr-$num.attempts"
    attempts=$(cat "$attempts_file" 2>/dev/null || echo 0)
    if [ "$attempts" -ge "$MAX_FIX" ]; then
      if [ ! -f "$STATE/pr-$num.stuck" ]; then
        gh pr comment "$num" --repo "$REPO" --body \
          "Builder agent: stopped after $MAX_FIX fix attempts. Close this PR to let me move on, or comment with guidance and delete \`~/state/pr-$num.*\` on agent-builder to retry." \
          && touch "$STATE/pr-$num.stuck"
      fi
      exit 0
    fi
    echo $((attempts + 1)) > "$attempts_file"

    git checkout -q -B "$branch" "origin/$branch"
    feedback=$(gh pr view "$num" --repo "$REPO" --json comments \
      --jq '[.comments[] | select(.body | startswith("## ai-review"))] | last | .body // "No review comment found."')

    run_claude "You are fixing pull request #$num on branch $branch.
CI result: $ci. ai-review result: $review.

Latest review feedback:
---
$feedback
---

If CI failed, reproduce it locally with the same commands as .github/workflows/ci.yml and fix the cause.
Address every required change in the review. Commit on this branch with clear messages. Do not push."

    if [ -n "$(git log "origin/$branch..HEAD" --oneline)" ]; then
      git push -q origin "$branch"
      log "pushed fix attempt $((attempts + 1)) for #$num"
    else
      log "no changes produced for #$num"
    fi
  fi
  exit 0   # never start new work while an agent PR is open
fi

# ---- 2. New work: oldest agent-ready issue not already attempted ----------
issue=""
for n in $(gh issue list --repo "$REPO" --state open --label agent-ready --json number --jq 'sort_by(.number) | .[].number'); do
  if [ ! -f "$STATE/issue-$n.done" ]; then issue=$n; break; fi
done
[ -z "$issue" ] && { log "nothing to do"; exit 0; }

title=$(gh issue view "$issue" --repo "$REPO" --json title --jq .title)
body=$(gh issue view "$issue" --repo "$REPO" --json body --jq .body)
branch="agent/issue-$issue"
git checkout -q -B "$branch" origin/main
log "starting #$issue: $title"

run_claude "Implement GitHub issue #$issue in this repository.

Title: $title
---
$body
---

You are on branch $branch. Follow the repository CLAUDE.md.
Build and test locally the same way .github/workflows/ci.yml does before you finish.
Commit your work with clear messages. Do not push and do not open a PR; that is handled for you."

if ! jq -e '.result and (.is_error | not)' "$STATE/last-run.json" >/dev/null 2>&1; then
  # API error, spend cap, crash: don't burn the issue, retry next tick.
  log "claude run failed for #$issue; see $STATE/last-run.err (will retry)"
  exit 0
fi
touch "$STATE/issue-$issue.done"
if [ -z "$(git log origin/main..HEAD --oneline)" ]; then
  log "no commits produced for #$issue"
  exit 0
fi

git push -q -u origin "$branch"
pr_url=$(gh pr create --repo "$REPO" --head "$branch" --base main --title "$title" \
  --body "Closes #$issue

Automated change by agent-builder.")
gh pr merge "$pr_url" --repo "$REPO" --auto --squash
log "opened $pr_url (auto-merge armed)"
{% endraw %}
