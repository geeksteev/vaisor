# Copy to .env (gitignored) and fill in what you need.
# API keys are only needed for AI vision features (e.g. judging a camera frame).
# Leave them empty if you only use meters and other instruments.

# Anthropic API key
ANTHROPIC_API_KEY=
# OpenAI API key (or the key your OpenAI-compatible endpoint expects)
OPENAI_API_KEY=
# Base URL for an OpenAI-compatible local endpoint; leave empty for api.openai.com
OPENAI_BASE_URL=

# Path to your bench description
VAISOR_CONFIG=bench.yaml
